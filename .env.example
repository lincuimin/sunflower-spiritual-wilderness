# Copy this file to .env
# SQLite (local dev)
DATABASE_URL="file:./dev.db"

# Auth (single admin)
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""
ADMIN_USERNAME="admin"
# Generate bcrypt hash (example):
# node -e "const bcrypt=require('bcryptjs'); console.log(bcrypt.hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=""

# AI Provider
# - openai (default)
# - deepseek
AI_PROVIDER=""

# Prefer using the generic key; if empty, will fall back to provider-specific keys.
AI_API_KEY=""

# DeepSeek (optional if you use AI_API_KEY)
DEEPSEEK_API_KEY=""

# Optional model name; if empty, provider default will be used
AI_MODEL=""

# Optional: use an OpenAI-compatible gateway/proxy (useful in restricted networks)
AI_BASE_URL=""

# Optional: request timeout in milliseconds (e.g. 25000)
AI_TIMEOUT_MS=""

# Legacy OpenAI vars (still supported)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
OPENAI_TIMEOUT_MS=""

# Vercel Blob (required for image upload)
# In Vercel, set this in Project Settings. For local dev, create a token and put it here.
BLOB_READ_WRITE_TOKEN=""
